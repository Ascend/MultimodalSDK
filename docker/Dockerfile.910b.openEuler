FROM swr.cn-south-1.myhuaweicloud.com/ascendhub/cann:9.1.0-910b-openeuler24.03-py3.12

USER root

WORKDIR /tmp

RUN cp -a /etc/yum.repos.d/openEuler.repo /etc/yum.repos.d/openEuler.repo.bak && \
    ARCH=$(uname -m | sed 's/x86_64/x86_64/; s/aarch64/aarch64/') && \
    echo "[openEuler-everything]" > /etc/yum.repos.d/openEuler.repo && \
    echo "name=openEuler-everything" >> /etc/yum.repos.d/openEuler.repo && \
    echo "baseurl=https://mirrors.huaweicloud.com/openeuler/openEuler-24.03-LTS/everything/${ARCH}/" >> /etc/yum.repos.d/openEuler.repo && \
    echo "enabled=1" >> /etc/yum.repos.d/openEuler.repo && \
    echo "gpgcheck=0" >> /etc/yum.repos.d/openEuler.repo && \
    echo "gpgkey=https://mirrors.huaweicloud.com/openeuler/openEuler-24.03-LTS/everything/${ARCH}/RPM-GPG-KEY-openEuler" >> /etc/yum.repos.d/openEuler.repo && \
    echo "" >> /etc/yum.repos.d/openEuler.repo && \
    echo "[openEuler-EPOL]" >> /etc/yum.repos.d/openEuler.repo && \
    echo "name=openEuler-epol" >> /etc/yum.repos.d/openEuler.repo && \
    echo "baseurl=https://mirrors.huaweicloud.com/openeuler/openEuler-24.03-LTS/EPOL/main/${ARCH}/" >> /etc/yum.repos.d/openEuler.repo && \
    echo "enabled=1" >> /etc/yum.repos.d/openEuler.repo && \
    echo "gpgcheck=0" >> /etc/yum.repos.d/openEuler.repo && \
    echo "" >> /etc/yum.repos.d/openEuler.repo && \
    echo "[openEuler-update]" >> /etc/yum.repos.d/openEuler.repo && \
    echo "name=openEuler-update" >> /etc/yum.repos.d/openEuler.repo && \
    echo "baseurl=https://mirrors.huaweicloud.com/openeuler/openEuler-24.03-LTS/update/${ARCH}/" >> /etc/yum.repos.d/openEuler.repo && \
    echo "enabled=1" >> /etc/yum.repos.d/openEuler.repo && \
    echo "gpgcheck=0" >> /etc/yum.repos.d/openEuler.repo

RUN export TZ=Asia/Shanghai && \
    yum clean all && \
    yum makecache && \
    yum install -y pcre2-devel perl-Capture-Tiny perl-DateTime && \
    yum clean all

# 安装git-lfs
RUN git clone https://gitee.com/src-openeuler/git-lfs && \
    cd git-lfs && \
    git checkout origin/openEuler-24.03-LTS && \
    mkdir -p ~/rpmbuild/SPECS && \
    mkdir -p ~/rpmbuild/RPMS && \
    mkdir -p ~/rpmbuild/SOURCES && \
    mkdir -p ~/rpmbuild/BUILD && \
    cp ./git-lfs.spec ~/rpmbuild/SPECS/ && \
    cp ./git-lfs-*.tar.gz ~/rpmbuild/SOURCES && \
    cp ./*.patch ~/rpmbuild/SOURCES && \
    yum install -y rpm-build golang && \
    cd ~/rpmbuild/SPECS && \
    rpmbuild -bb git-lfs.spec && \
    dnf install -y ../RPMS/$(arch)/git-lfs-*.rpm

ARG SWIG_VERSION=4.3.0
ARG SWIG_SHA256=f7203ef796f61af986c70c05816236cbd0d31b7aa9631e5ab53020ab7804aa9e
RUN curl -fsSL "https://downloads.sourceforge.net/project/swig/swig/swig-${SWIG_VERSION}/swig-${SWIG_VERSION}.tar.gz" -o swig.tgz && \
    echo "${SWIG_SHA256}  swig.tgz" | sha256sum -c - && \
    tar -xzf swig.tgz && \
    cd "swig-${SWIG_VERSION}" && \
    ./configure --prefix=/usr/local && make -j"$(nproc)" && make install && \
    cd .. && rm -rf swig.tgz "swig-${SWIG_VERSION}"

RUN pip3 config set global.trusted-host repo.huaweicloud.com && \
    pip3 config set global.index-url https://repo.huaweicloud.com/repository/pypi/simple && \
    pip3 config set global.timeout 200

RUN mkdir /vllm-workspace/ && cd /vllm-workspace/ && \
    git clone --branch v0.8.5 https://atomgit.com/GitHub_Trending/vl/vllm.git && \
    git clone --branch v0.8.5rc1 https://gitcode.com/gh_mirrors/vl/vllm-ascend.git

RUN cd /vllm-workspace/vllm-ascend && \
    sed -i '/inner_kernel_operator_intf.h/d' csrc/kernels/pos_encoding_kernels.cpp && \
    sed -i 's/torch-npu==2.5.1/torch-npu==2.6.0.post5/g' pyproject.toml && \
    sed -i 's/torch>=2.5.1/torch>=2.6.0/g' pyproject.toml && \
    sed -i 's/torchvision<0.21.0/torchvision==0.21.0/g' pyproject.toml && \
    sed -i 's/torch-npu==2.5.1/torch-npu==2.6.0.post5/g' requirements.txt && \
    sed -i 's/torch>=2.5.1/torch>=2.6.0/g' requirements.txt && \
    sed -i 's/torchvision<0.21.0/torchvision==0.21.0/g' requirements.txt && \
    sed -i 's/--cmake/--cmakedir/' setup.py

RUN cd /vllm-workspace/vllm && VLLM_TARGET_DEVICE=empty pip3 install -e  .

RUN cd /vllm-workspace/vllm-ascend && source /usr/local/Ascend/ascend-toolkit/set_env.sh && pip3 install --extra-index -e .

# delete cmake from pip3, useless after compile of vllm-ascend
RUN pip3 uninstall -y cmake triton

RUN pip3 install transformers==4.51.3 && \
    pip3 install pillow==11.2.1 && \
    pip3 install numpy==1.26.4 && \
    pip3 install "setuptools<82"

RUN wget https://gitcode.com/Ascend/MultimodalSDK/releases/download/v26.1.0/Ascend-mindxsdk-multimodal_26.1.0_linux-aarch64.run && \
    chmod +x Ascend-mindxsdk-multimodal_26.1.0_linux-aarch64.run && \
    bash Ascend-mindxsdk-multimodal_26.1.0_linux-aarch64.run --install --install-path=/usr/local && \
    ln -s /usr/lib64/libbz2.so.1.0.8 /usr/local/multimodal/opensource/FFmpeg/lib/libbz2.so.1.0

# Download the MultimodalSDK test image into the container.
RUN mkdir -p /data && \
    wget --tries=3 --timeout=30 --waitretry=5 -O /data/test.jpg https://raw.gitcode.com/Ascend/MultimodalSDK/blobs/f1f648b7a8b8a67c7509b3425a89f743bbf59563/dog_1920_1080.jpg && \
    chmod 640 /data/test.jpg

RUN rm -rf ./*

RUN sed -i '$a\source /usr/local/multimodal/script/set_env.sh' ~/.bashrc

RUN groupadd -r -g 1000 HwHiAiUser && \
    useradd -r -g HwHiAiUser -u 1000 -m -s /bin/bash HwHiAiUser && \
    echo "HwHiAiUser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

WORKDIR /root

RUN mkdir -p /opt/multimodal && \
    wget -q https://github.com/linux-test-project/lcov/releases/download/v2.0/lcov-2.0.tar.gz -O /opt/multimodal/lcov-2.0.tar.gz && \
    wget -q https://mindcluster.obs.cn-north-4.myhuaweicloud.com/opensource.tar.gz -O /opt/multimodal/opensource.tar.gz && \
    git clone --depth 1 -b release-2.5.0 https://gitcode.com/gh_mirrors/ma/makeself.git /opt/multimodal/makeself && \
    git clone --depth 1 -b v2.5.0.x https://gitcode.com/cann-src-third-party/makeself.git /opt/multimodal/makeself_patch && \
    git clone --depth 1 -b v2.13.6 https://gitcode.com/GitHub_Trending/py/pybind11.git /opt/multimodal/pybind11 && \
    git clone --depth 1 -b release-1.11.0 https://gitcode.com/GitHub_Trending/go/googletest.git /opt/multimodal/googletest
